# ==============================================================================
# Fair Share Environment Variables
# ==============================================================================

# Database Connection (MySQL)
DB_HOST=localhost         # Database host (e.g., localhost or cloud URL)
DB_USER=root              # Database user
DB_PASSWORD=yourpassword  # Database password
DB_PORT=3306              # Database port (default 3306)
DB_NAME=FairShare_DB      # Database name

# Security
# Run `openssl rand -hex 32` to generate a secure random string
SESSION_SECRET=your_super_secret_session_key_here
